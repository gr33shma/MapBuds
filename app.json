{
  "expo": {
    "name": "MapBuds",
    "slug": "mapbuds",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "android": {
      "package": "com.mapbuds.app"
    },
    "ios": {
      "bundleIdentifier": "com.mapbuds.app"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "MapBuds uses your location to show your avatar on the map and give live directions."
        }
      ]
    ]
  }
}
