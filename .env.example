# Copy this file to `.env` (do NOT commit .env — it's already in .gitignore)
# and fill in the real values. Person 1 has both of these from setting up
# navigation/routingService.js and navigation/disruptionService.js.
#
# The EXPO_PUBLIC_ prefix is required — Expo only exposes env vars to your
# app code (via process.env.X) if they start with this prefix.

EXPO_PUBLIC_ONEMAP_TOKEN=paste_onemap_access_token_here
EXPO_PUBLIC_LTA_KEY=paste_lta_datamall_account_key_here
